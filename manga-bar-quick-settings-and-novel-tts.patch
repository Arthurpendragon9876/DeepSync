+                bottomMargin = viewBinding.root.height - dock.top + gap
+                leftMargin = dockParams.leftMargin
+                rightMargin = dockParams.rightMargin
+            } else {
+                // Wide layouts keep the bar in the top bar: the panel just rests at the bottom
