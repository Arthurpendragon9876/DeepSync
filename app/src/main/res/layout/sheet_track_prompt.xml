<?xml version="1.0" encoding="utf-8"?>
<!-- "Save progress?" bottom sheet (portrait), compact: a one-line header, the matches side by side (smaller
     when there are more than two), the "don't ask" switch, the two answers and the two links.
     The landscape twin is in layout-land; both must keep the same ids. -->
<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:fillViewport="false">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="14dp"
		android:paddingTop="8dp"
		android:paddingBottom="10dp">

		<View
			android:layout_width="28dp"
			android:layout_height="4dp"
			android:layout_gravity="center_horizontal"
			android:layout_marginBottom="10dp"
			android:background="@drawable/bg_track_handle" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="top"
			android:orientation="horizontal">

			<ImageView
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:layout_marginTop="2dp"
				android:background="@drawable/bg_track_prompt_icon"
				android:importantForAccessibility="no"
				android:padding="8dp"
				android:src="@drawable/ic_bookmark_checked"
				app:tint="?attr/colorOnSecondaryContainer" />

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="10dp"
				android:layout_weight="1"
				android:orientation="vertical">

				<TextView
					android:id="@+id/text_title"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/ds_track_sheet_title"
					android:textColor="?attr/colorOnSurface"
					android:textSize="16sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/text_message"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="1dp"
					android:ellipsize="end"
					android:maxLines="2"
					android:textColor="?attr/colorOnSurfaceVariant"
					android:textSize="11sp" />

			</LinearLayout>

		</LinearLayout>

		<FrameLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:minHeight="48dp">

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/list_matches"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:clipToPadding="false"
				android:orientation="horizontal"
				android:visibility="gone"
				app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

			<com.google.android.material.progressindicator.CircularProgressIndicator
				android:id="@+id/progress"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
				android:indeterminate="true"
				app:indicatorSize="24dp" />

			<TextView
				android:id="@+id/text_none"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
				android:gravity="center"
				android:textColor="?attr/colorOnSurfaceVariant"
				android:textSize="12sp"
				android:visibility="gone" />

		</FrameLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingHorizontal="2dp">

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/ds_track_remember"
				android:textColor="?attr/colorOnSurface"
				android:textSize="12sp"
				android:textStyle="bold" />

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switch_remember"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:scaleX="0.8"
				android:scaleY="0.8" />

		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:orientation="horizontal">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_device"
				style="@style/Widget.Material3.Button.TonalButton"
				android:layout_width="0dp"
				android:layout_height="40dp"
				android:layout_weight="1"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:paddingVertical="0dp"
				android:text="@string/ds_track_device_only"
				android:textSize="12sp"
				app:cornerRadius="20dp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_save"
				android:layout_width="0dp"
				android:layout_height="40dp"
				android:layout_marginStart="8dp"
				android:layout_weight="1"
				android:enabled="false"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:paddingVertical="0dp"
				android:text="@string/ds_track_sheet_save"
				android:textSize="12sp"
				app:cornerRadius="20dp" />

		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:orientation="horizontal">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_search"
				style="@style/Widget.Material3.Button.OutlinedButton"
				android:layout_width="0dp"
				android:layout_height="38dp"
				android:layout_weight="1"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:paddingHorizontal="10dp"
				android:paddingVertical="0dp"
				android:text="@string/ds_track_search_other"
				android:textSize="12sp"
				app:cornerRadius="19dp"
				app:icon="@drawable/ic_search"
				app:iconGravity="textStart"
				app:iconPadding="6dp"
				app:iconSize="16dp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/button_no"
				style="@style/Widget.Material3.Button.OutlinedButton"
				android:layout_width="wrap_content"
				android:layout_height="38dp"
				android:layout_marginStart="8dp"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:minWidth="72dp"
				android:paddingHorizontal="16dp"
				android:paddingVertical="0dp"
				android:text="@string/ds_track_no"
				android:textSize="12sp"
				app:cornerRadius="19dp" />

		</LinearLayout>

	</LinearLayout>
</ScrollView>
