+		NovelControl.ROTATE -> if (isRotationLocked) R.drawable.ic_screen_rotation_lock else R.drawable.ic_screen_rotation
+		NovelControl.OPTIONS -> if (isOpen) R.drawable.ic_close else R.drawable.ic_tune
