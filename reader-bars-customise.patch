diff -ruN DeepSync-main.orig/android/app/src/main/kotlin/org/koitharu/kotatsu/core/prefs/ReaderBarLayout.kt DeepSync-main/android/app/src/main/kotlin/org/koitharu/kotatsu/core/prefs/ReaderBarLayout.kt
