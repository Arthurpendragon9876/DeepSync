+			zip.entries().asSequence().associate {
+				it.name to Json.parseToJsonElement(zip.getInputStream(it).readBytes().decodeToString()).jsonArray
+			}
+		}
+	}
+
+	private fun JsonObject.long(key: String) = getValue(key).jsonPrimitive.longOrNull
