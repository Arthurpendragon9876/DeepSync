<?xml version="1.0" encoding="utf-8"?>
<!-- Live preview of the reader's top bar for the "Customise reader bottom bar and top bar"
     settings screen: a back arrow, then the two real ReaderActionsView groups (left and right
     side) reading the same preference as the reader, with a transparent overlay on top that
     swallows every touch — the preview is look-only. -->
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/bg_card"
		android:backgroundTint="?colorSurfaceContainerLowest"
		android:gravity="center_vertical"
		android:minHeight="?actionBarSize"
		android:orientation="horizontal"
		android:paddingHorizontal="@dimen/margin_small">

		<ImageView
			android:id="@+id/preview_back"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:importantForAccessibility="no"
			android:padding="12dp"
			android:src="@drawable/ic_arrow_back"
			app:tint="?colorOnSurface" />

		<org.koitharu.kotatsu.reader.ui.ReaderActionsView
			android:id="@+id/actionsTopStart"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:readerBarArea="topStart" />

		<Space
			android:layout_width="0dp"
			android:layout_height="1dp"
			android:layout_weight="1" />

		<org.koitharu.kotatsu.reader.ui.ReaderActionsView
			android:id="@+id/actionsTopEnd"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:readerBarArea="topEnd" />

	</LinearLayout>

	<View
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clickable="true"
		android:focusable="false"
		android:importantForAccessibility="no" />

</FrameLayout>
